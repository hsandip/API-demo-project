PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Comma-separated list of allowed origins for CORS (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security — keep it server-side
# only, never expose it to the frontend or commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
